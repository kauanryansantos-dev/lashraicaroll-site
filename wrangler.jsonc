// Cloudflare Workers: só arquivos estáticos da pasta site/ (sem código no servidor).
// Os cabeçalhos de segurança vêm de site/_headers.
{
  "name": "lashraicaroll",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./site",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "workers_dev": true,
  "preview_urls": false
}
